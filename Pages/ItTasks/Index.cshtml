@page
@model wt_lab8_8razor_postgresql_findrik.Pages.ItTasks.IndexModel
@{
    ViewData["Title"] = "Наши проекты";
}

<div class="container py-2">
    <div class="d-flex justify-content-between align-items-center mb-4 pb-3" style="border-bottom: 2px solid var(--ivory);">
        <h1 class="fw-bold m-0" style="color: var(--midnight-blue);">Проекты и задачи</h1>
        <a asp-page="/ItTasks/Create" class="btn btn-primary px-4 py-2">+ Добавить задачу</a>
    </div>

    <form method="get" class="mb-4 d-flex gap-2">
    <input type="text" name="Search" value="@Model.Search" class="form-control" placeholder="Поиск по названию задачи..." style="max-width: 300px;" />
    <button type="submit" class="btn btn-primary">Найти</button>
    </form>

    <div class="row g-4">
        @foreach (var task in Model.Tasks)
        {
            <div class="col-12 col-md-6 col-lg-4">
                <div class="card h-100">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <span class="badge">ID: @task.Id</span>
                        <span class="badge" style="background-color: var(--dusty-blue) !important; color: white !important;">@task.Priority</span>
                    </div>
                    <div class="card-body d-flex flex-column p-4">
                        <h4 class="card-title fw-bold mb-3" style="color: var(--midnight-blue);">@task.Title</h4>
                        <p class="mb-2" style="color: var(--dusty-blue);">Проект: <strong style="color: var(--deep-navy);">@task.ProjectName</strong></p>
                        <p class="mb-3" style="color: var(--dusty-blue);">Часы: <strong style="color: var(--deep-navy);">@task.EstimatedHours ч.</strong></p>
                        <p class="mb-4" style="color: var(--dusty-blue);">Статус: <strong style="color: var(--deep-navy);">@(task.IsCompleted ? "Выполнено" : "В работе")</strong></p>
                        
                        <div class="mt-auto d-flex flex-column gap-2">
                            <a asp-page="/ItTasks/Details" asp-route-id="@task.Id" class="btn btn-outline-primary w-100">Подробнее</a>
                            <div class="d-flex gap-2">
                                <a asp-page="/ItTasks/Edit" asp-route-id="@task.Id" class="btn btn-success w-50">Изменить</a>
                                <form method="post" asp-page-handler="Delete" asp-route-id="@task.Id" class="w-50" onsubmit="return confirm('Удалить задачу?');">
                                    <button type="submit" class="btn btn-danger w-100">Удалить</button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>